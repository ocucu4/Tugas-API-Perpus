          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/buku",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "buku"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kode\": \"B001\",\n  \"judul\": \"Judul Lain\",\n  \"penulis\": \"Penulis Lain\",\n  \"tahun\": 2020,\n  \"stok\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. PUT Ubah Buku (B001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
